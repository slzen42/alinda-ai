# ─────────────────────────────────────────────────────────────────────────────
# frontend-react/.gitignore
#
# Placed inside frontend-react/ so it governs only the React application.
# The project root .gitignore governs the Python backend.
# ─────────────────────────────────────────────────────────────────────────────


# ── Dependencies ──────────────────────────────────────────────────────────────
# The entire reason this file exists — node_modules is what caused the
# 8000-file commit. Never tracked. Reconstructed from package-lock.json
# via npm install.
node_modules/
.pnp
.pnp.js


# ── Build output ──────────────────────────────────────────────────────────────
# Generated by `npm run build`. Contains minified, hashed production
# bundles. Never committed — rebuilt on every Vercel / Render deployment.
dist/
dist-ssr/


# ── Vite dev server cache ────────────────────────────────────────────────────
# Vite writes optimized pre-bundled dependencies here. Regenerated
# automatically on first `npm run dev`. Committing it bloats the repo
# with binary files that differ across machines.
.vite/


# ── Environment files ────────────────────────────────────────────────────────
# .env.local contains VITE_API_URL and VITE_WS_URL — the backend origin
# for this specific developer's machine. Never committed; each dev sets
# their own. Production values are set as environment variables on the
# hosting platform (Vercel / Render), not in files.
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local


# ── Editor and OS artifacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.user
.idea/
.vscode/settings.json
.vscode/launch.json
# Keep .vscode/extensions.json — useful to share recommended extensions


# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ── Test / coverage output ────────────────────────────────────────────────────
coverage/
.nyc_output/


# ── TypeScript build info ─────────────────────────────────────────────────────
# Not using TypeScript currently, but if a jsconfig.json ever emits
# these, they don't belong in the repo.
*.tsbuildinfo


# ── Storybook (if ever added) ─────────────────────────────────────────────────
storybook-static/


# ── Misc ─────────────────────────────────────────────────────────────────────
*.local
.cache/