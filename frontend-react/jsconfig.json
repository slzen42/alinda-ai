{
    "compilerOptions": {
      "baseUrl": ".",
      "paths": {
        "canvas/*":     ["src/canvas/*"],
        "paintings/*":  ["src/paintings/*"],
        "screens/*":    ["src/screens/*"],
        "components/*": ["src/components/*"],
        "hooks/*":      ["src/hooks/*"],
        "lib/*":        ["src/lib/*"],
        "animations/*": ["src/animations/*"],
        "design/*":     ["src/design/*"],
        "store/*":      ["src/store/*"],
        "utils/*":      ["src/utils/*"]
      },
      "jsx": "react-jsx",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "target": "ES2020",
      "allowImportingTsExtensions": false,
      "checkJs": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
  }